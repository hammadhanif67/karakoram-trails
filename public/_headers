# Cloudflare Pages response headers for static files (API responses set their own headers).

# Booking status page: the URL carries the customer's access token.
/booking
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex
/booking/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

/checkout/*
  X-Robots-Tag: noindex

# Hashed build output: the file name changes whenever the content does, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photo file names carry a hash of their bytes (scripts/optimize-images.mjs), so they can be cached for a year too.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The credits list keeps its name, so it must not get the year-long cache above.
/images/CREDITS.md
  ! Cache-Control
  Cache-Control: public, max-age=3600
