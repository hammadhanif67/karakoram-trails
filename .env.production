# Read by `next build` (production builds, including Cloudflare Pages). Public values only:
# NEXT_PUBLIC_* are compiled into the static JavaScript that every visitor downloads.
# Turnstile site key for karakoram-trails.pages.dev (public; its secret key is a Pages secret, never
# put it here). For local testing build with the testing key instead, e.g.
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build   (shell env overrides this file)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFEiDtMisRvK_koZ
