# Copy to .dev.vars for local `wrangler pages dev` (never commit .dev.vars).
# Production secrets: npx wrangler pages secret put NAME --project-name karakoram-trails
# Non-secret settings live in wrangler.toml [vars] (DEPOSIT_PERCENT, HOLD_HOURS, TURNSTILE_HOSTNAMES,
# PUBLIC_SITE_URL); values here override them locally. The Turnstile SITE key is in .env.production.

# Turnstile (stage 2). Production: your widget's secret, TURNSTILE_HOSTNAMES = your real domain(s),
# and never TURNSTILE_ALLOW_TEST_KEYS. Local testing can use Cloudflare's public testing keys:
#   site key 1x00000000000000000000AA (build with NEXT_PUBLIC_TURNSTILE_SITE_KEY), secret below,
#   which returns hostname "example.com" and no action.
TURNSTILE_SECRET_KEY=
# Local override of the wrangler.toml value (the testing keys report hostname example.com):
TURNSTILE_HOSTNAMES=example.com
# TURNSTILE_ALLOW_TEST_KEYS=true

# Bank transfer instructions shown to the booking's owner (stage 2)
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_IBAN=
RAAST_ID=

# Admin login (stage 3). Password login is used while the site runs on karakoram-trails.pages.dev:
#   node scripts/hash-admin-password.mjs   → prints ADMIN_PASSWORD_HASH and a SESSION_SECRET
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional, for a custom domain later: Cloudflare Access (either login method is accepted).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=
# Local only (ignored on any real hostname): act as this admin without logging in.
# ADMIN_DEV_EMAIL=

# Notifications (stage 4)
# Telegram admin alerts (new booking, receipt uploaded): bot token from @BotFather, chat id of you/your group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional n8n webhook (skipped while empty). n8n verifies
# X-KT-Signature = sha256=HMAC_SHA256(N8N_WEBHOOK_SECRET, "<X-KT-Timestamp>.<body>").
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Customer emails: off until EMAIL_API_KEY is set (Resend; MAIL_FROM on a verified domain).
EMAIL_API_KEY=
MAIL_FROM=
# Local override of the wrangler.toml value:
PUBLIC_SITE_URL=http://127.0.0.1:8788
