{
  "name": "northern-pakistan-tours",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/snapshot-catalog.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/snapshot-catalog.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "optimize-images": "node scripts/optimize-images.mjs",
    "preview": "npx serve out -l 4173",
    "postbuild": "node scripts/flatten-segment-files.mjs",
    "db:migrate:local": "wrangler d1 migrations apply karakoram-trails --local",
    "db:migrate:remote": "wrangler d1 migrations apply karakoram-trails --remote",
    "db:seed:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-d1.mjs --local",
    "db:seed:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-d1.mjs --remote",
    "db:check:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-d1.mjs --local --check",
    "db:check:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-d1.mjs --remote --check",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "pages:dev": "wrangler pages dev --port 8788"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  }
}
