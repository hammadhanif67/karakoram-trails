# Cloudflare Pages response headers for static files (API responses set their own headers).

# Booking status page: the URL carries the customer's access token.
/booking
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex
/booking/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

/checkout/*
  X-Robots-Tag: noindex

# Hashed build output: the file name changes whenever the content does, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos keep their names when replaced, so only one day for now (versioned file names come with the images update).
/images/*
  Cache-Control: public, max-age=86400
