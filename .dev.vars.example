# Copy to .dev.vars for local `wrangler pages dev` (never commit .dev.vars).
# In production set these in Cloudflare Pages → Settings → Variables and Secrets.
# Non-secret defaults (DEPOSIT_PERCENT, HOLD_HOURS) live in wrangler.toml [vars].

# Turnstile (stage 2). Production: your widget's secret, TURNSTILE_HOSTNAMES = your real domain(s),
# and never TURNSTILE_ALLOW_TEST_KEYS. Local testing can use Cloudflare's public testing keys:
#   site key 1x00000000000000000000AA (build with NEXT_PUBLIC_TURNSTILE_SITE_KEY), secret below,
#   which returns hostname "example.com" and no action.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# TURNSTILE_ALLOW_TEST_KEYS=true

# Bank transfer instructions shown to the booking's owner (stage 2)
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_IBAN=
RAAST_ID=

# Admin via Cloudflare Access (stage 3). Production: from the Access application protecting
# /admin* and /api/admin*. ADMIN_EMAILS is checked in addition to the Access policy.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=
# Local only (ignored on any real hostname): act as this admin without Access.
# ADMIN_DEV_EMAIL=

# Notifications (stage 4). n8n verifies X-KT-Signature = sha256=HMAC_SHA256(secret, "<X-KT-Timestamp>.<body>").
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Resend (https://resend.com); MAIL_FROM must be on a domain verified in Resend.
EMAIL_API_KEY=
MAIL_FROM=Karakoram Trails <bookings@your-domain.com>
ADMIN_NOTIFY_EMAIL=
PUBLIC_SITE_URL=https://your-domain.com
# EMAIL_API_URL=  (local testing only; defaults to https://api.resend.com/emails)
